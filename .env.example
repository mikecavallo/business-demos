# Needed only for --provider anthropic (default model: claude-sonnet-5-5)
ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Needed only for --provider openai
OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-5.5

# Default provider when --provider is not given: anthropic | openai | mock
# SITEGEN_PROVIDER=mock
